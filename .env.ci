# ============================================================
# CI 专用环境变量 — 所有凭据均为合成测试值，仅用于 GitHub Actions。
# 生产环境请使用 .env（git-ignored），不要在此文件中存放真实密钥。
# ============================================================

POSTGRES_DB=autogallery
POSTGRES_USER=autogallery
POSTGRES_PASSWORD=ci-postgres-password

REDIS_PASSWORD=ci-redis-password

MEILI_MASTER_KEY=ci-meilisearch-master-key-32chars
MEILI_ENV=development

SECRET_KEY=ci-secret-key-32chars-minimum-value
ADMIN_PASSWORD=ci-admin-password

HOST_DOWNLOADS=auto_gallery_ci_downloads
HOST_LIBRARY=auto_gallery_ci_library
HOST_CONFIG_APP=auto_gallery_ci_config_app
HOST_CONFIG_GALLERYDL=auto_gallery_ci_config_gallerydl
HOST_POSTGRES=auto_gallery_ci_postgres
HOST_REDIS=auto_gallery_ci_redis
HOST_MEILISEARCH=auto_gallery_ci_meilisearch

TIMEZONE=UTC
BACKEND_PORT=8818
ADMIN_WEB_PORT=13000
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:13000
BACKEND_INTERNAL_URL=http://backend:8000
MEILI_HTTP_ADDR=meilisearch:7700

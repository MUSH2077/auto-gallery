# ============================================================
# auto-gallery .env.example
# Copy to .env and fill in values before running docker compose.
# .env is git-ignored — never commit real passwords or keys.
# ============================================================

# --- PostgreSQL ---
POSTGRES_DB=autogallery
POSTGRES_USER=autogallery
POSTGRES_PASSWORD=change-me-postgres

# --- Redis ---
REDIS_PASSWORD=change-me-redis

# --- Meilisearch ---
MEILI_MASTER_KEY=change-me-meilisearch
MEILI_ENV=production
MEILI_INDEX_PREFIX=
MEILI_SEARCH_TIMEOUT_SECONDS=3
# Keep indexing bounded inside the 512M Meilisearch cgroup.
MEILI_MAX_INDEXING_MEMORY=320Mb

# 16 GB NAS performance profile. Docker limits are ceilings, not reservations.
RESOURCE_DEVICE_PROFILE=auto
POSTGRES_MEM_LIMIT=768M
REDIS_MEM_LIMIT=256M
MEILI_MEM_LIMIT=1G
MIGRATE_MEM_LIMIT=512M
BACKEND_MEM_LIMIT=1G
DOWNLOAD_WORKER_MEM_LIMIT=512M
IMPORT_WORKER_MEM_LIMIT=1G
OPERATIONS_WORKER_MEM_LIMIT=1G
SCHEDULER_MEM_LIMIT=512M
ADMIN_WEB_MEM_LIMIT=512M
MEILI_MAX_INDEXING_THREADS=1

# --- Application ---
SECRET_KEY=change-me-secret-key-at-least-32-chars
# Allowed bootstrap default for first login: admin / change-me-admin.
# The web UI forces a password change immediately after login.
ADMIN_PASSWORD=change-me-admin

# --- Container paths (do not change these) ---
DOWNLOAD_ROOT=/downloads
LIBRARY_ROOT=/library
GALLERYDL_CONFIG_ROOT=/gallerydl-config
APP_CONFIG_ROOT=/app-config

# --- Host paths (NAS deployment — uncomment and adjust) ---
# HOST_DOWNLOADS=/volume1/auto-gallery/downloads
# HOST_LIBRARY=/volume1/auto-gallery/library
# HOST_CONFIG_APP=/volume1/auto-gallery/config/app
# HOST_CONFIG_GALLERYDL=/volume1/auto-gallery/config/gallery-dl
# HOST_POSTGRES=/volume1/auto-gallery/docker/postgres
# HOST_REDIS=/volume1/auto-gallery/docker/redis
# HOST_MEILISEARCH=/volume1/auto-gallery/docker/meilisearch

# --- Local development paths (default — works out of the box) ---
HOST_DOWNLOADS=./data/downloads
HOST_LIBRARY=./data/library
HOST_CONFIG_APP=./data/config/app
HOST_CONFIG_GALLERYDL=./data/config/gallery-dl
HOST_POSTGRES=./data/docker/postgres
HOST_REDIS=./data/docker/redis
HOST_MEILISEARCH=./data/docker/meilisearch

# --- Timezone (e.g. UTC, Asia/Shanghai, America/New_York) ---
TIMEZONE=UTC

# --- Build ---
# Uncomment if you need mirrors (e.g., in China)
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# NPM_REGISTRY=https://registry.npmmirror.com
# Frontend build heap inside the project-local bounded BuildKit cgroup. This
# is not the admin-web runtime heap. Keep it below LOCAL_BUILD_MEMORY_LIMIT.
ADMIN_BUILD_NODE_HEAP_MB=640
# deploy.sh accepts this as a command environment override rather than a
# Compose setting, for example:
# LOCAL_BUILD_MEMORY_LIMIT=1280m bash scripts/deploy.sh

# --- Backend ---
BACKEND_PORT=8818
ACCESS_TOKEN_EXPIRE_MINUTES=1440
MEDIA_PLAYBACK_TTL_SECONDS=7200
# PostgreSQL connection budgets are per Python process.
DB_POOL_SIZE=8
DB_MAX_OVERFLOW=4
WORKER_DB_POOL_SIZE=1
WORKER_DB_MAX_OVERFLOW=1
# Warn before the backend reaches its 512M cgroup limit.
MEMORY_WARN_MB=420
TASK_RECONCILIATION_INTERVAL_SECONDS=60
TASK_COMPACTION_INTERVAL_SECONDS=300
TASK_COMPACTION_BATCH_SIZE=200
TASK_COMPACTION_ENABLED=true
# LOG_LEVEL=INFO
# Gitllery is still product v1; this controls the segment-format rollout.
GITLLERY_PROJECTION_MODE=shadow
GITLLERY_BUILD_GENERATION=segment-r1
# Comma-separated allowed origins for the admin web. Set to your NAS LAN IP or domain.
# Example: http://192.0.2.10:13000,https://autogallery.yourdomain.com
# CORS_ORIGINS=http://localhost:13000

# --- Admin Web ---
ADMIN_WEB_PORT=13000
# Leave native-memory headroom under the admin-web 256M cgroup limit.
NODE_MAX_OLD_SPACE_MB=160
# Internal backend URL used by Next.js server-side API proxy
BACKEND_INTERNAL_URL=http://backend:8000
# Optional public WebSocket endpoint for live job updates.
# Use this when your reverse proxy does not forward /api/v1/ws to backend.
# Jobs still update through polling if WebSocket is unavailable.
# Examples:
# NEXT_PUBLIC_WS_URL=ws://192.0.2.10:8818/api/v1/ws
# NEXT_PUBLIC_WS_URL=wss://autogallery.yourdomain.com/api/v1/ws
# Rebuild admin-web after changing NEXT_PUBLIC_* values.
# NEXT_PUBLIC_WS_URL=
# Public URL for the exact source version offered to network users.
# Forks and modified deployments must point this at their Corresponding Source.
NEXT_PUBLIC_SOURCE_CODE_URL=https://github.com/MUSH2077/auto-gallery

# --- Meilisearch ---
MEILI_HTTP_ADDR=meilisearch:7700

# --- Project-local adaptive resource protection ---
# These are runtime controls. Deployment does not reject a host because of
# global memory, Swap, PSI, or vendor-process thresholds.
DOWNLOAD_CONCURRENCY_CAP=1
DOWNLOAD_STAGING_ENABLED=1
RESOURCE_GOVERNANCE_MODE=enforce
RESOURCE_GOVERNANCE_MAX_SCALE=1.0
RESOURCE_GOVERNANCE_ENFORCED_PROFILES=download_network,import_db,image_derive,video_derive,search_index,maintenance
RESOURCE_MEMORY_RESERVE_MODE=auto
RESOURCE_MEMORY_RESERVE_RATIO=0.15
RESOURCE_MEMORY_RESERVE_MIN_MB=384
RESOURCE_MEMORY_RESERVE_MAX_MB=1280
# Hard aggregate ceiling across queued, scheduled and deferred download jobs.
DOWNLOAD_QUEUE_MAX_PENDING=100
VIPS_CONCURRENCY=1
VIPS_CACHE_MAX_MEM_MB=64

# Optional project cgroup ceilings. They are upper safety fuses, not reserved
# host memory; omit them to use the portable defaults in docker-compose.yaml.
# BACKEND_MEM_LIMIT=512M
# IMPORT_WORKER_MEM_LIMIT=640M
# ADMIN_WEB_MEM_LIMIT=256M

# Optional physical block device for docker-compose.nas-io.yaml.
# Resolve the device backing your Docker bind mounts with lsblk/findmnt first.
# Do not guess: a wrong path either prevents startup or throttles the wrong disk.
# NAS_BLOCK_DEVICE=/dev/sdb

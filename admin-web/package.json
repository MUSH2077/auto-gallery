{
  "name": "auto-gallery-admin",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "generate:api-types": "openapi-typescript http://localhost:8818/openapi.json -o src/lib/api/types.generated.ts",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "screenshots:readme": "UPDATE_README_SCREENSHOTS=1 PLAYWRIGHT_MANAGE_SERVER=1 playwright test tests/e2e/readme-screenshots.spec.ts --project=chromium --workers=1",
    "start": "next start --port 3000"
  },
  "dependencies": {
    "@tanstack/react-query": "5.101.4",
    "animejs": "^4.5.0",
    "d3-hierarchy": "^3.1.2",
    "lucide-react": "^1.27.0",
    "next": "16.2.12",
    "ogl": "^1.0.11",
    "playwright-core": "^1.60.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.5.4",
    "openapi-typescript": "7.13.0",
    "postcss": "8.5.24",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@redocly/openapi-core": {
      "js-yaml": "4.3.0",
      "minimatch": {
        "brace-expansion": "5.0.8"
      }
    },
    "next": {
      "postcss": "8.5.24",
      "sharp": "0.35.3"
    }
  }
}

{
  "name": "auto-gallery-admin",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "prepare:api-docs": "node scripts/copy-api-doc-assets.mjs",
    "predev": "npm run prepare:api-docs",
    "dev": "next dev --port 3000",
    "prebuild": "npm run prepare:api-docs && npm run generate:i18n-catalog",
    "build": "next build && node scripts/check-bundle-budgets.mjs",
    "check:bundle-budgets": "node scripts/check-bundle-budgets.mjs",
    "generate:i18n-catalog": "node scripts/generate-i18n-catalog.mjs",
    "check:i18n-catalog": "node scripts/generate-i18n-catalog.mjs --check",
    "generate:api-types": "openapi-typescript ../docs/api/openapi.json -o src/lib/api/types.generated.ts",
    "check:api-types": "node scripts/check-api-types.mjs",
    "check:admin-routes": "node scripts/check-admin-routes.mjs",
    "check:charts": "node scripts/check-charts.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:media": "node scripts/check-media.mjs",
    "check:search-contract": "node scripts/check-search-contract.mjs",
    "test:reference-list": "node --no-warnings --test tests/reference-list-state.test.mjs",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "screenshots:readme": "UPDATE_README_SCREENSHOTS=1 PLAYWRIGHT_MANAGE_SERVER=1 playwright test tests/e2e/readme-screenshots.spec.ts --project=chromium --workers=1",
    "start": "next start --port 3000"
  },
  "dependencies": {
    "@tanstack/react-query": "5.103.1",
    "@tanstack/react-virtual": "3.14.13",
    "animejs": "^4.5.0",
    "d3-hierarchy": "^3.1.2",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "playwright-core": "^1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "redoc": "2.5.4",
    "swagger-ui-dist": "5.33.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@tailwindcss/postcss": "4.3.3",
    "@playwright/test": "^1.63.0",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "openapi-typescript": "7.13.0",
    "postcss": "8.5.28",
    "tailwindcss": "4.3.3",
    "typescript": "5.7.2"
  },
  "overrides": {
    "@redocly/openapi-core": {
      "js-yaml": "4.3.2",
      "minimatch": {
        "brace-expansion": "5.0.9"
      }
    },
    "next": {
      "postcss": "8.5.24",
      "sharp": "0.35.4"
    }
  }
}

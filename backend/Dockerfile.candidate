ARG BASE_IMAGE=auto-gallery-backend:latest
FROM ${BASE_IMAGE}

WORKDIR /app
ARG CACHEBUST=1
RUN find /app -mindepth 1 -maxdepth 1 -exec rm -rf -- {} +
COPY . .
RUN pip install --no-cache-dir --no-deps . && pip check

ENV PYTHONMALLOC=malloc \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
